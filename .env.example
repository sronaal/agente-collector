# Identificacion unica del agente (UUID v4)
AGENT_ID=<UUID_DEL_AGENTE>

# Conexion AMI hacia Asterisk
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USUARIO=callmetric
AMI_SECRETO=<PASSWORD_AMI>

# Backend central
BACKEND_URL=http://<IP_BACKEND>:8080
TOKEN_REGISTRO=<TOKEN_DE_REGISTRO>

# Intervalos de tiempo en segundos
INTERVALO_HEARTBEAT=30
TIMEOUT_ACCION=5.0
TIMEOUT_CONEXION=10.0
TIMEOUT_LECTURA=30.0

# Buffer offline
RUTA_BUFFER=/tmp/callmetric/buffer.db
TAMANO_MAXIMO_BUFFER=10000

# Logging
NIVEL_LOG=WARNING

# CDR Database (MySQL de Asterisk para reportes historicos)
CDR_DB_HOST=localhost
CDR_DB_PORT=3306
CDR_DB_NAME=asteriskcdrdb
CDR_DB_USER=dev
CDR_DB_PASSWORD=<PASSWORD_CDR>
CDR_REPORT_INTERVAL=90
CDR_REPORT_ACTIVE=true
