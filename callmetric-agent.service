[Unit]
Description=CallMetric Pro Agent - Asterisk monitoring collector
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=exec
User=root
WorkingDirectory=/opt/callmetric/agente_v3
ExecStart=/opt/callmetric/agente_v3/run.sh
Restart=always
RestartSec=10s
StartLimitInterval=300
StartLimitBurst=10
StartLimitAction=none

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full

# Logging
StandardOutput=append:/var/log/callmetric/agent-stdout.log
StandardError=append:/var/log/callmetric/agent-stderr.log

[Install]
WantedBy=multi-user.target
